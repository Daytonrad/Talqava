# Copy this file to .env and fill in what you need. Everything is optional
# when you run on your own computer: you can paste the API key into the
# Settings page instead.

# Your Anthropic API key (console.anthropic.com -> API keys).
ANTHROPIC_API_KEY=

# Required when the agent is reachable from other machines (a server, Docker).
# Pick a long one; this is the only thing between the internet and a shell.
AGENT_PASSWORD=

# Where the page listens. Keep 127.0.0.1 on your own computer.
# HOST=127.0.0.1
# PORT=8787

# Where the agent keeps its memory, chats and working files.
# AGENT_DATA_DIR=./data
